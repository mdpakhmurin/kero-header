PORT=3210
# Для Docker: адрес публикации порта (по умолчанию только этот компьютер).
BIND_ADDRESS=127.0.0.1
# Внешний адрес при размещении за HTTPS-прокси. Для локального запуска оставьте пустым.
PUBLIC_ORIGIN=
# Глобальные администраторы: числовые ID пользователей через запятую, например 1,2.
GLOBAL_ADMIN_IDS=1
