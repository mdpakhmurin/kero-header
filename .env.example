# Токены VK каждый пользователь сохраняет в своём аккаунте.
# Необязательный ключ шифрования: 32 случайных байта в Base64, задаётся до первого запуска.
# Если пусто, приложение создаёт ключ в data/secrets/vk-token.key автоматически.
TOKEN_ENCRYPTION_KEY=
PORT=3210
# Глобальные администраторы: ID пользователей через запятую.
GLOBAL_ADMIN_IDS=
